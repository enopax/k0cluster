# Hetzner Cloud Configuration
# This file will be copied to .env.<cluster_name>
# The cluster name is derived from the filename, not from a variable

# Hetzner Cloud API Token (base64 encoded)
# OPTIONAL: If you have hcloud CLI configured, the script will auto-detect the token
#           from your active context. Leave empty to use hcloud auto-detection.
# Manual setup: Get your token from https://console.hetzner.cloud/
#               Then encode it: echo -n "your-token-here" | base64
# hcloud setup: hcloud context create <name>
#               hcloud context use <name>
HETZNER_TOKEN_BASE64=

# Cluster Configuration
CLUSTER_NAMESPACE=kcm-system

# Hetzner Region (fsn1, nbg1, hel1, ash, or other supported regions)
HETZNER_REGION=fsn1

# k0s Version
K0S_VERSION=v1.32.6+k0s.1
K0S_DOWNLOAD_URL=https://github.com/k0sproject/k0s/releases/download/v1.32.6+k0s.1/k0s-v1.32.6+k0s.1-amd64

# Cluster Sizing
CONTROL_PLANE_COUNT=3
WORKER_COUNT=2

# Machine Types (see https://www.hetzner.com/cloud for options)
CONTROL_PLANE_MACHINE_TYPE=cx21
WORKER_MACHINE_TYPE=cx21

# Chart Sources (configure each chart independently)
# Version is included in the source URL/path
# You can mix local and remote sources as needed for development

# Cluster Template Name (must match installed ClusterTemplate in k0rdent)
CLUSTER_CHART_NAME=hetzner-standalone-cp

# Cluster Chart (hetzner-standalone-cp)
# Remote (published):
CLUSTER_CHART_SOURCE=oci://ghcr.io/enopax/templates/hetzner-standalone-cp:1.0.0
# Local (for development - uncomment and update version in filename):
# CLUSTER_CHART_SOURCE=file://templates/cluster/hetzner-standalone-cp-1.0.0.tgz

# Provider Chart (cluster-api-provider-hetzner)
# Remote (published):
PROVIDER_CHART_SOURCE=oci://ghcr.io/enopax/templates/cluster-api-provider-hetzner:0.0.5
# Local (for development - uncomment and update version in filename):
# PROVIDER_CHART_SOURCE=file://templates/provider/cluster-api-provider-hetzner-0.0.5.tgz

# Management Cluster Configuration
# Where to deploy k0rdent (which then creates the Hetzner workload cluster)
MGMT_CLUSTER_TYPE=kind  # 'kind' for local development, 'hetzner' for remote k0s on Hetzner VM

# Note: kubectl context names follow consistent schema:
#   kind:    kind-{cluster_name}
#   hetzner: hetzner-{cluster_name}
